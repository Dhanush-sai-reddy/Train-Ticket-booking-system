// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://railrover_user:railrover_password@localhost:5432/railrover?schema=public"
}

model Station {
  code      String   @id
  name      String
  state     String?
  zone      String?
  address   String?
  longitude Float?
  latitude  Float?

  // Relations
  trainsFrom      Train[]         @relation("FromStation")
  trainsTo        Train[]         @relation("ToStation")
  trainSchedules  TrainSchedule[]

  @@map("stations")
}

model Train {
  number          String   @id
  name            String
  type            String?
  zone            String?
  returnTrain     String?  @map("return_train")
  classes         String?
  thirdAc         Int      @default(0) @map("third_ac")
  chairCar        Int      @default(0) @map("chair_car")
  firstClass      Int      @default(0) @map("first_class")
  sleeper         Int      @default(0)
  secondAc        Int      @default(0) @map("second_ac")
  durationH       Int?     @map("duration_h")
  durationM       Int?     @map("duration_m")
  departure       String?
  arrival         String?
  fromStationCode String?  @map("from_station_code")
  toStationCode   String?  @map("to_station_code")

  // Relations
  fromStation     Station?        @relation("FromStation", fields: [fromStationCode], references: [code])
  toStation       Station?        @relation("ToStation", fields: [toStationCode], references: [code])
  trainSchedules  TrainSchedule[]

  @@map("trains")
}

model TrainSchedule {
  id            Int      @id
  trainNumber   String   @map("train_number")
  stationCode   String   @map("station_code")
  day           Int
  arrival       String?
  departure     String?

  // Relations
  train         Train    @relation(fields: [trainNumber], references: [number])
  station       Station  @relation(fields: [stationCode], references: [code])

  @@map("train_schedules")
}
